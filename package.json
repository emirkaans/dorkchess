{
  "name": "dorkchess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.engine.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --experimental-strip-types --no-warnings scripts/bench.ts",
    "selfplay": "node --experimental-strip-types --no-warnings scripts/selfplay.ts",
    "match": "node --experimental-strip-types --no-warnings scripts/match.ts",
    "gen-data": "node --experimental-strip-types --no-warnings scripts/gen-data.ts",
    "tune": "node --experimental-strip-types --no-warnings --max-old-space-size=8192 scripts/tune.ts",
    "sf-match": "node --experimental-strip-types --no-warnings scripts/sf-match.ts",
    "sf-label": "node --experimental-strip-types --no-warnings scripts/sf-label.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity": "node --experimental-strip-types --no-warnings scripts/parity.ts",
    "icons": "node --experimental-strip-types --no-warnings scripts/make-icons.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
