{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/engine", "src/ai", "src/clock", "src/rules", "src/storage", "src/i18n"],
  // The worker entry and its client need the browser Worker API; they are checked by tsconfig.app.json.
  "exclude": ["src/ai/worker.ts", "src/ai/client.ts"]
}
