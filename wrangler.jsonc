// Cloudflare Worker: the built site (dist/) plus the online game server.
// Deploy: npm run deploy. Local server for development: npm run dev:server.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "punkchess",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages, the API and preview pictures reach the Worker (www redirect, game link previews);
    // the static files are served directly, which costs no Worker requests.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/icons/*",
      "!/hero.webp",
      "!/jackets/*",
      "!/stockfish/*",
      "!/robots.txt",
      "!/og.png",
      "!/manifest.webmanifest",
      "!/sw.js",
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "TOURNAMENT", "class_name": "Tournament" },
    ],
  },
  // Accounts (server/auth.ts). Schema: migrations/ (npx wrangler d1 migrations apply punkchess --remote).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "punkchess",
      "database_id": "a722258c-7f0f-46fd-8a7a-6179c57fd808",
      "migrations_dir": "migrations",
    },
  ],
  // GOOGLE_CLIENT_SECRET is a secret: wrangler secret put GOOGLE_CLIENT_SECRET (locally: .dev.vars).
  "vars": { "GOOGLE_CLIENT_ID": "146944465320-9ak9165g6o32vgmb1c5g21d5qj8ivvu1.apps.googleusercontent.com" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v3", "new_sqlite_classes": ["Tournament"] },
  ],
  "routes": [
    { "pattern": "punkchess.com", "custom_domain": true },
    { "pattern": "www.punkchess.com", "custom_domain": true },
  ],
  // Requests per visitor and minute (server/limits.ts). namespace_id: any number unique in the account.
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 90, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "1003", "simple": { "limit": 240, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
